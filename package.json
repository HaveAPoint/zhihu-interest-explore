{
  "name": "zhihu-interest-explore",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/fixtures",
    "packages/ui-tokens",
    "plugin",
    "web",
    "server"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint . --ext .ts,.tsx",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "echo 'E2E tests not yet configured'",
    "test:agent-contract": "vitest run --project agent-contract",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "package:release": "tsx scripts/package-release.ts",
    "release:check": "tsx scripts/release-check.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "vitest": "^3.0.0",
    "@cloudbase/cli": "^3.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
