# CloudBase
CLOUDBASE_ENV_ID=hackerson-d0g0z55d2fc446485

# Public (VITE_ prefix for web app)
VITE_APP_ORIGIN=http://localhost:5173
VITE_API_ORIGIN=http://localhost:9000
VITE_EXTENSION_ID=

# Server only (never exposed to browser)
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:9000
EXTENSION_ID=

# OAuth (server only)
ZHIHU_CLIENT_ID=
ZHIHU_CLIENT_SECRET=
ZHIHU_REDIRECT_URI=http://localhost:5173/auth/callback

# Database (server only)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zhihu_explore
PG_USER=postgres
PG_PASSWORD=

# Agent mode: mock | live
AGENT_MODE=mock

# Session
SESSION_TTL_DAYS=30

# Development auth bypass (MUST be false in production)
DEV_AUTH=true

# Guest limits
GUEST_RATE_LIMIT_PER_MINUTE=10
GUEST_DAILY_BUDGET=100
GENERATION_TIMEOUT_MS=30000
